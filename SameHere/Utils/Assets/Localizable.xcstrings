        }
      }
    },
    "That didn't go through: %@" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo completar: %@"
          }
        }
      }
    },
    "The server sent something unexpected." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servidor respondió algo inesperado."
          }
        }
      }
    },
    "There's zero tolerance for objectionable content or abusive users. You can report any thought and block anyone. Content that breaks these rules is removed, and accounts that post it may be banned." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No toleramos contenido ofensivo ni usuarios abusivos. Puedes reportar cualquier pensamiento y bloquear a cualquier persona. El contenido que rompa estas reglas se elimina, y las cuentas que lo publiquen pueden ser suspendidas."
          }
        }
      }
    },
    "This permanently deletes your account, your thoughts and your answers. This can't be undone." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina para siempre tu cuenta, tus pensamientos y tus respuestas. No se puede deshacer."
          }
        }
      }
    },
