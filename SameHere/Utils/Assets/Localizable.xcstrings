    },
    "That contains words that aren't allowed in Same Here. Please rephrase it." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contiene palabras que no se permiten en Same Here. Intenta decirlo de otra forma."
