        }
      }
    },
    "You already answered this one." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya respondiste esta pregunta."
          }
        }
      }
    },
    "You appear to be offline. Check your connection and try again." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece que no tienes conexión. Revísala e inténtalo de nuevo."
          }
        }
      }
    },
    "You don't have permission to do that." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes permiso para hacer eso."
          }
        }
      }
    },
    "You won't see it again. Thoughts reported by several people are hidden for everyone." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No lo volverás a ver. Los pensamientos que reportan varias personas se ocultan para todos."
          }
        }
      }
    },
    "You won't see their thoughts anymore." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no verás sus pensamientos."
          }
        }
      }
    },
    "You're all caught up" : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás al día"
          }
        }
      }
    },
    "You're signed in as a guest, so everything lives only on this iPhone. Add an email and you'll keep it if you switch phones." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entraste como invitado, así que todo se guarda solo en este iPhone. Agrega un correo y lo conservarás si cambias de teléfono."
          }
        }
      }
    },
    "Your account is still on this device. It'll come back as soon as you're connected." : {
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta sigue en este dispositivo. Volverá en cuanto tengas conexión."
          }
        }
      }
    },
